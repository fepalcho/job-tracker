{
  "hosting": {
    "site": "job-tracker-jeremy",
    "public": "dist/frontend/browser",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/**", "run": { "serviceId": "api-nestjs", "region": "europe-west1" } },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
